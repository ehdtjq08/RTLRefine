        "replacement": "         bit_cnt = 0;\n         for (i = 0; i <= KEEP_WIDTH; i = i + 1) begin\n             if (monitor_axis_tkeep == ({KEEP_WIDTH{1'b1}}) >> (KEEP_WIDTH-i)) bit_cnt = i;\n         end\n         frame_len_next = frame_len_next + bit_cnt;",
